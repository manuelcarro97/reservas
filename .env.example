# Solo placeholders: copia este fichero a .env y pon tus valores. .env no se sube al repo.

# Base de datos de docker compose (las lee compose.yaml para el contenedor db y para la conexión de la API).
POSTGRES_DB=reservas
POSTGRES_USER=reservas
POSTGRES_PASSWORD=change-me

# Variables de la API (ver "Cómo ejecutar" en el README). Van comentadas porque un valor vacío anula el valor por
# defecto de la aplicación: descomenta solo las que uses. docker compose NO las pasa al contenedor api: añádelas a su
# "environment" en compose.yaml o expórtalas antes de ./mvnw spring-boot:run.
# Todas las que son secretas (marcadas) van solo aquí, en tu .env local; nunca con un valor real en el repo.

# PORT=8080
# FORWARD_HEADERS_STRATEGY=none
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# Firebase Authentication
# FIREBASE_PROJECT_ID=tu-proyecto-firebase
# SECRETO: JSON completo de la cuenta de servicio, en una sola línea y entre comillas simples.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'

# Telegram (hacen falta las dos a la vez)
# SECRETO: token que da BotFather.
# TELEGRAM_BOT_TOKEN=123456789:token-de-botfather
# TELEGRAM_BOT_USERNAME=nombre_del_bot

# Cuenta demo
# DEMO_ENABLED=false
# DEMO_UID=demo-owner
# DEMO_EMAIL=demo@example.com
# SECRETO
# DEMO_PASSWORD=change-me
